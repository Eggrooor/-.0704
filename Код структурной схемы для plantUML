@startuml
title Структурная схема поточного многофазного влагомера «Квалитет» ВМП.0704\n(с детализацией информационных потоков от ПТК)

skinparam rectangle {
    BackgroundColor<<hazard>> #EAF2FB
    BorderColor<<hazard>> #2E5C8A
    BackgroundColor<<sensor>> #E8F5E9
    BorderColor<<sensor>> #2E7D32
    BackgroundColor<<ptk>> #FFF8E1
    BorderColor<<ptk>> #B8860B
    BackgroundColor<<out>> #F3E5F5
    BorderColor<<out>> #6A1B9A
}

package "Зона взрывоопасная (скважинная продукция)" <<hazard>> {
    rectangle "1. Технологический трубопровод\n(многофазный поток:\nнефть + пластовая вода + газ)" as PIPE <<hazard>>

    rectangle "2. Измерительный модуль МИ.0702\n(от 1 до 8 шт., устанавливается\nв поток по месту)" as IM <<hazard>> {
        rectangle "3. Чувствительный элемент\n(обкладки датчика в потоке,\nизм. комплексного сопротивления)" as SENS <<sensor>>
        rectangle "4. Плата предварительного\nусилителя сигнала" as AMP <<sensor>>
        SENS --> AMP : первичный сигнал
    }
    PIPE --> IM : измеряемая среда
}

rectangle "5. Программно-технический комплекс\nПТК.0701 / вычислитель ПВ.0703" as PTK <<ptk>> {
    rectangle "Микропроцессор и ПО:\nвычисление влагосодержания" as MPU <<ptk>>
    rectangle "Память калибровочных\nкоэффициентов" as CALIB <<ptk>>
    rectangle "Блок питания 220 В / 24 В" as PSU <<ptk>>

    CALIB --> MPU : калибровочные коэффициенты
    PSU --> MPU : питание
}

rectangle "6. Индикация и регистрация\n(дисплей, память)" as IND <<out>>
rectangle "7. Выходные интерфейсы\nRS-485, Ethernet, 4–20 мА" as IFACE <<out>>
rectangle "8. АСУ ТП /\nтелеметрия" as ASUTP <<out>>

' --- Связь измерительного модуля и ПТК ---
IM <--> PTK : **цифровой сигнал**\n(кабель RS-485)\n→ от ПТК: команды опроса,\nконфигурация, калибровка\n← от МИ: первичные данные

' --- Данные ОТ ПТК ---
PTK <--> IND : **от ПТК:**\nвлагосодержание, статусы,\nархивные записи\n**к ПТК:** команды управления
PTK --> IFACE : **от ПТК:**\nрезультаты измерений,\nдиагностика, статусы\n(4–20 мА / RS-485 / Ethernet)
PTK --> ASUTP : **от ПТК:**\nтелеметрия, события,\nаварийные сигналы

note right of PTK
  **Информационные потоки от ПТК:**
  1) Влагосодержание (расчётное)
  2) Диагностика и статусы
  3) Архивные данные
  4) Телеметрия / события
  5) Управляющие команды
     (опрос, калибровка)
end note

@enduml
